# Lo más fácil es configurar todo desde la app: Más -> Ajustes -> Claves.
# Este archivo guarda tus claves SOLO en tu PC. Nunca lo compartas.
# Clave de la API de Claude (console.anthropic.com) - activa el analista IA
ANTHROPIC_API_KEY=
# Clave gratis de The Odds API (the-odds-api.com) - momios de Pinnacle y más casas
ODDS_API_KEY=
# Modelo de IA (opcional)
AI_MODEL=claude-opus-5-5
# Dirección de actualizaciones (version.json publicado)
UPDATE_MANIFEST_URL=
